# ==============================================================================
# Portfolio Environment Variables Configuration
# ==============================================================================
# For Vercel Deployment:
# Go to Project Settings -> Environment Variables and add any variable you want to customize.
# Next.js requires the 'NEXT_PUBLIC_' prefix for variables accessed on the client side.
# All variables are optional and will safely fall back to default values if not provided.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site & Domain Configuration
# ------------------------------------------------------------------------------
# Base deployment URL (Used in sitemap.xml, robots.txt, and OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=https://shubham-acharya.dev

# ------------------------------------------------------------------------------
# 2. Personal & Contact Information
# ------------------------------------------------------------------------------
NEXT_PUBLIC_NAME="Shubham Acharya"
NEXT_PUBLIC_TITLE="AI Backend Developer"
NEXT_PUBLIC_ROLE_HEADLINE="Building Production-Ready AI Backend Systems"
NEXT_PUBLIC_SUBTITLE="Agentic AI • LLM Workflows • FastAPI • LangGraph"
NEXT_PUBLIC_DESCRIPTION="I build scalable AI applications that orchestrate LLMs, workflow automation, and backend services using modern AI infrastructure."
NEXT_PUBLIC_LOCATION="Bengaluru, India"
NEXT_PUBLIC_EMAIL="shubhamacharya258@gmail.com"

# ------------------------------------------------------------------------------
# 3. Social & Profile Links
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GITHUB_URL="https://github.com/shubhamacharya77"
NEXT_PUBLIC_GITHUB_USERNAME="shubhamacharya77"
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/in/shubham-acharya-3a5a9b423"
NEXT_PUBLIC_RESUME_URL="/Shubham_Acharya_Resume.pdf"
NEXT_PUBLIC_PROFILE_IMAGE="/profile_picture.png"

# ------------------------------------------------------------------------------
